{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "price": {
      "type": "number",
      "title": "Pre\u00e7o"
    },
    "category": {
      "type": "string",
      "title": "Categoria",
      "enum": [
        "Past\u00e9is Salgados",
        "Past\u00e9is Doces",
        "Bebidas",
        "Adicionais"
      ]
    },
    "image_url": {
      "type": "string",
      "title": "Imagem URL"
    },
    "available": {
      "type": "boolean",
      "title": "Dispon\u00edvel",
      "default": true
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ]
}