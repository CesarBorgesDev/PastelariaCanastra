# Copie para deploy/vps.env antes de rodar o script no VPS.
#   cp deploy/vps.env.example deploy/vps.env

# Porta publicada pelo container pastelaria-frontend.
WEB_PORT=80

# Senha do Postgres. Troque antes de expor o servidor.
POSTGRES_USER=pastelaria
POSTGRES_PASSWORD=pastelaria
POSTGRES_DB=pastelaria

# true = abre as portas 22 e WEB_PORT no UFW.
ENABLE_UFW=false
